{
  "name": "@maida-ai/opencode",
  "version": "0.2.0",
  "description": "Maida plugin for OpenCode — records OpenCode sessions as Maida traces.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "maida",
    "opencode",
    "behavioral-regression",
    "ci-gate",
    "tracing",
    "ai-agents",
    "local-first"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@maida-ai/core": "^0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
